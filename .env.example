# Routeful 環境変数テンプレート
# 使い方: cp .env.example .env.local してから各キーを埋める
# .env.local は Git 管理しない（.gitignore 済み）
#
# 変数の命名規則:
#   NEXT_PUBLIC_* … フロント (Next.js) に露出してよい値。Vercel にも設定
#   それ以外       … バックエンド (Flask / Render) でのみ使う値。絶対にフロントへ出さない

# === Frontend (apps/web) ===

# Supabase（匿名認証 + DB クライアント）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mapbox タイル (pk.* の public token)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxx

# Flask API のベース URL
# ローカル:  http://localhost:5000
# 本番:     https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# === Backend (apps/api) ===

# OpenAI GPT-4o
OPENAI_API_KEY=sk-...

# Google Maps Platform（Places / Routes / Geocoding は同一キー）
GOOGLE_MAPS_API_KEY=AIza...

# Supabase service_role（RLS バイパス、サーバーのみで使用）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 楽天トラベル API (Phase 2 以降)
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=

# Flask 実行設定
FLASK_ENV=development
PORT=5000
